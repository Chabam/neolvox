{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "conan",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/conan_toolchain.cmake"
      }
    },
    {
      "name": "standalone",
      "cacheVariables": {
        "LVOX_COMPUTREE_BINDINGS": "OFF",
        "LVOX_STANDALONE": "ON",
        "LVOX_R": "OFF"
      }
    },
    {
      "name": "standalone-conan",
      "inherits": [ "base", "standalone", "conan" ]
    },
    {
      "name": "standalone-conan-dev",
      "inherits": [ "standalone-conan" ],
      "cacheVariables": {
        "BUILD_TESTING" : "ON"
      }
    },
    {
      "name": "R",
      "inherits": [ "base" ],
      "cacheVariables": {
        "LVOX_COMPUTREE_BINDINGS": "OFF",
        "LVOX_STANDALONE": "OFF",
        "LVOX_R": "ON",
        "BUILD_TESTING": "OFF"
      }
    }
  ]
}
